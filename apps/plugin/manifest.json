{
  "manifest_version": 3,
  "name": "JobMatch Copilot",
  "version": "0.1.0",
  "description": "Scores job postings against your profile and autofills applications.",
  "permissions": ["storage", "alarms", "scripting", "activeTab"],
  "host_permissions": ["__WEB_APP_URL__/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/jobs/view/*",
        "https://boards.greenhouse.io/*/jobs/*",
        "https://job-boards.greenhouse.io/*/jobs/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["__WEB_APP_URL__/connect*"],
      "js": ["connect-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobMatch Copilot"
  }
}
