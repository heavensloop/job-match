{
  "manifest_version": 3,
  "name": "JobMatch Copilot",
  "version": "0.1.0",
  "description": "Scores job postings against your profile and autofills applications.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://localhost:3000/*", "http://localhost:3100/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/jobs/view/*",
        "https://boards.greenhouse.io/*/jobs/*",
        "https://job-boards.greenhouse.io/*/jobs/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobMatch Copilot"
  }
}
