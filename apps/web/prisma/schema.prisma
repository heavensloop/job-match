// Prisma schema for the Web App/API. Mirrors the domain model in
// .claude/plan.md §4. Tables that are also shared with the Plugin have a
// corresponding Zod schema in packages/shared (see the comment on each
// model below); jobs_seen, users, and personal_access_tokens are
// Web-App-only and have no shared schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WorkMode {
  remote
  hybrid
  onsite
}

enum SearchScope {
  global_remote
  local_only
}

enum EmploymentType {
  full_time
  part_time
  contract
  internship
}

enum CrawlCadence {
  hourly
  daily
  weekly
}

enum ApplicationDraftStatus {
  reviewed
  submitted
  skipped
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  person               Person?
  searchCriteria       SearchCriteria[]
  jobsSeen             JobSeen[]
  applicationDrafts    ApplicationDraft[]
  personalAccessTokens PersonalAccessToken[]

  @@map("users")
}

// Mirrors packages/shared/src/person.ts (PersonSchema) — the constant
// identity shared across all of a user's JobProfiles.
model Person {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  legalName   String  @map("legal_name")
  displayName String? @map("display_name")
  email       String
  phone       String?
  address     String?

  jobProfiles JobProfile[]

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("people")
}

// Mirrors packages/shared/src/jobProfile.ts (JobProfileSchema) — one of a
// person's many job-application profiles (1:many, unlike the constant
// identity fields on Person above).
model JobProfile {
  id       String @id @default(uuid())
  personId String @map("person_id")
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  // Doubles as the label a person uses to tell their profiles apart in a
  // list, so it's unique per person (see @@unique below).
  jobTitle  String  @map("job_title")
  bio       String?
  isDefault Boolean @default(false) @map("is_default")

  // Structured data. Stored as JSON rather than normalized tables since
  // JobProfileSchema in packages/shared is the single source of truth
  // for its shape.
  skills         Json   @default("[]")
  socialLinks    Json   @default("{}") @map("social_links")
  experiences    Json   @default("[]")
  education      Json   @default("[]")
  certifications Json   @default("[]")
  yearsOfExperience Float? @map("years_of_experience")

  resumeBlobUrl String? @map("resume_blob_url")
  resumeText    String? @map("resume_text")

  // Field key -> value an ATS form might expect (legal name vs. display name).
  autofillAliases Json @default("{}") @map("autofill_aliases")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  applicationDrafts ApplicationDraft[]

  @@unique([personId, jobTitle])
  @@map("job_profiles")
}

// Mirrors packages/shared/src/searchCriteria.ts (SearchCriteriaSchema).
model SearchCriteria {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  isDefault Boolean @default(false) @map("is_default")

  workMode       WorkMode[]       @map("work_mode")
  scope          SearchScope
  locations      String[]
  employmentType EmploymentType[] @map("employment_type")

  minAnnualSalary Float? @map("min_annual_salary")
  minHourlyRate   Float? @map("min_hourly_rate")
  currency        String @default("USD")

  // { keywords: string[], companies: string[] }
  exclusions Json @default("{\"keywords\":[],\"companies\":[]}")

  updatedAt DateTime @updatedAt @map("updated_at")

  jobBoardSources   JobBoardSource[]
  applicationDrafts ApplicationDraft[]

  @@map("search_criteria")
}

// Mirrors packages/shared/src/jobBoardSource.ts (JobBoardSourceSchema).
model JobBoardSource {
  id         String         @id @default(uuid())
  criteriaId String         @map("criteria_id")
  criteria   SearchCriteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)

  name          String
  baseUrl       String       @map("base_url")
  queryTemplate String       @map("query_template")
  cadence       CrawlCadence @default(daily)
  lastFetchedAt DateTime?    @map("last_fetched_at")
  enabled       Boolean      @default(true)

  jobsSeen JobSeen[]

  @@map("job_board_sources")
}

// Dedup index for every job the user has encountered — crawled (decision
// #21: no vetting data written at crawl time) or viewed live in the Plugin.
// sourceId is null for a live-viewed job with no matching job_board_source;
// non-null once the crawler (or a later view) links it to one.
model JobSeen {
  id       String          @id @default(uuid())
  userId   String          @map("user_id")
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId String?         @map("source_id")
  source   JobBoardSource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  url         String
  title       String
  company     String
  firstSeenAt DateTime @default(now()) @map("first_seen_at")

  applicationDrafts ApplicationDraft[]

  @@unique([userId, url])
  @@map("jobs_seen")
}

// Mirrors packages/shared/src/applicationDraft.ts (ApplicationDraftSchema).
// vettingSnapshot's shape is packages/shared/src/vettingResult.ts (VettingResultSchema).
model ApplicationDraft {
  id           String         @id @default(uuid())
  userId       String         @map("user_id")
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId        String         @map("job_id")
  job          JobSeen        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  criteriaId   String         @map("criteria_id")
  criteria     SearchCriteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)
  jobProfileId String         @map("job_profile_id")
  jobProfile   JobProfile     @relation(fields: [jobProfileId], references: [id], onDelete: Cascade)

  vettingSnapshot  Json                   @map("vetting_snapshot")
  autofillFieldMap Json                   @default("{}") @map("autofill_field_map")
  userEdits        Json                   @default("{}") @map("user_edits")
  status           ApplicationDraftStatus @default(reviewed)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // One draft per (job, criteria set, job profile) — the vetting endpoint
  // upserts on this to cache by (url, jobProfileVersion, criteriaId),
  // §5.9. jobProfileId is part of the key because different profiles
  // score differently against the same job.
  @@unique([jobId, criteriaId, jobProfileId])
  @@map("application_drafts")
}

// Plugin auth (decision #12). No shared Zod schema — never leaves the Web App.
model PersonalAccessToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  name       String
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")

  @@map("personal_access_tokens")
}
